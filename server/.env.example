# Copy this file to ".env" for running on your own computer. On Render you type these into "Environment" instead.
# NEVER commit the real .env file (it is already in .gitignore).

# Your PostgreSQL connection string (Neon gives you this; keep ?sslmode=require on the end).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# A long random secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Which website addresses may call this API (comma separated, no trailing slash).
# GitHub Pages example: https://YOURNAME.github.io
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional
PORT=3000
# Number of proxies in front of the server (Render = 1). Needed so rate limits see the real visitor address.
TRUST_PROXY=1
# Biggest request body in megabytes (published site snapshots can be big)
MAX_BODY_MB=20
